<UserControl x:Class="FPlusClone.Views.Tabs.TabNuoiTKView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FPlusClone.Views.Controls"
             xmlns:vm="clr-namespace:FPlusClone.ViewModels"
             Background="#f0f0f0">
    <UserControl.DataContext>
        <vm:TabNuoiTKViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="450"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- CỘT TRÁI: DATA GRID & TÀI KHOẢN -->
        <Border Grid.Column="0" Background="White" BorderBrush="#ccc" BorderThickness="1" Padding="10">
            <controls:TaskAccountManagerView />
        </Border>

        <!-- CỘT PHẢI: CẤU HÌNH -->
        <Border Grid.Column="2" Background="White" BorderBrush="#ccc" BorderThickness="1" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="CẤU HÌNH NUÔI TÀI KHOẢN " FontSize="14" FontWeight="Bold" Foreground="#333" Margin="0,0,0,15"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cấu hình (Bên trái của cột phải) -->
                    <StackPanel Grid.Column="0">
                        <!-- Thời gian nuôi và cảm xúc -->
                        <Border BorderBrush="#dadce0" BorderThickness="1" Background="#fafbfc" Padding="15" Margin="0,0,0,15">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Thời gian nuôi (phút)" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="Tổng thời gian lướt feed / tài khoản" FontSize="11" Foreground="#888"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" BorderBrush="#dadce0" BorderThickness="1" Background="White">
                                        <TextBox Text="{Binding FeedTime}" BorderThickness="0" Padding="5" HorizontalContentAlignment="Center" Background="Transparent"/>
                                    </Border>
                                </Grid>
                                
                                <TextBlock Text="Cảm xúc sẽ thả" FontSize="12" FontWeight="SemiBold" Margin="0,5,0,5"/>
                                <WrapPanel Margin="0,0,0,10">
                                    <CheckBox Content="👍 Like" IsChecked="{Binding IsEmotionLike}" Margin="0,0,10,5" VerticalAlignment="Center"/>
                                    <CheckBox Content="❤️ Tym" IsChecked="{Binding IsEmotionTym}" Margin="0,0,10,5" VerticalAlignment="Center"/>
                                    <CheckBox Content="🥰 Thương" IsChecked="{Binding IsEmotionThuong}" Margin="0,0,10,5" VerticalAlignment="Center"/>
                                    <CheckBox Content="😆 Haha" IsChecked="{Binding IsEmotionHaha}" Margin="0,0,10,5" VerticalAlignment="Center"/>
                                    <CheckBox Content="😮 Wow" IsChecked="{Binding IsEmotionWow}" Margin="0,0,10,5" VerticalAlignment="Center"/>
                                    <CheckBox Content="😢 Buồn" IsChecked="{Binding IsEmotionBuon}" Margin="0,0,10,5" VerticalAlignment="Center"/>
                                    <CheckBox Content="😡 Phẫn nộ" IsChecked="{Binding IsEmotionPhanNo}" Margin="0,0,10,5" VerticalAlignment="Center"/>
                                </WrapPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Delay thả cảm xúc (giây)" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Border BorderBrush="#dadce0" BorderThickness="1" Background="White" Width="40">
                                            <TextBox Text="{Binding DelayMin}" BorderThickness="0" Padding="5" HorizontalContentAlignment="Center" Background="Transparent"/>
                                        </Border>
                                        <TextBlock Text="-" VerticalAlignment="Center" Margin="5,0"/>
                                        <Border BorderBrush="#dadce0" BorderThickness="1" Background="White" Width="40">
                                            <TextBox Text="{Binding DelayMax}" BorderThickness="0" Padding="5" HorizontalContentAlignment="Center" Background="Transparent"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Đọc thông báo -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Đọc thông báo" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="Số lượng thông báo" FontSize="11" Foreground="#888"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsReadNoti}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <Border BorderBrush="#dadce0" BorderThickness="1" Background="#fafbfc" Width="50">
                                    <TextBox Text="{Binding ReadNotiCount}" BorderThickness="0" Padding="5" HorizontalContentAlignment="Center" Background="Transparent"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Nhắn tin (Chat) -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Tự động trò chuyện (Chat)" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="Mở messenger trả lời ngẫu nhiên" FontSize="11" Foreground="#888"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding IsChat}" VerticalAlignment="Center">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                                </CheckBox.LayoutTransform>
                            </CheckBox>
                        </Grid>

                        <!-- Lặp lại tiến trình -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Lặp lại tiến trình" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="Số vòng lặp" FontSize="11" Foreground="#888"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsRepeat}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <Border BorderBrush="#dadce0" BorderThickness="1" Background="White" Width="50">
                                    <TextBox Text="{Binding RepeatCount}" IsEnabled="{Binding IsRepeat}" BorderThickness="0" Padding="5" HorizontalContentAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Số luồng chạy -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Số luồng chạy đồng thời" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="Mở bao nhiêu tab cùng lúc" FontSize="11" Foreground="#888"/>
                            </StackPanel>
                            <Border Grid.Column="1" BorderBrush="#dadce0" BorderThickness="1" Background="#fafbfc">
                                <TextBox Text="{Binding MaxThreads}" BorderThickness="0" Padding="5" HorizontalContentAlignment="Center" Background="Transparent"/>
                            </Border>
                        </Grid>

                        <!-- Reset DCOM -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Reset DCOM / đổi IP" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="Sau bao nhiêu tài khoản" FontSize="11" Foreground="#888"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsResetDcom}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <Border BorderBrush="#dadce0" BorderThickness="1" Background="#fafbfc" Width="50">
                                    <TextBox Text="{Binding ResetDcomAfter}" BorderThickness="0" Padding="5" HorizontalContentAlignment="Center" Background="Transparent"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Start/Stop & Logs (Bên phải của cột phải, giống hệt TabSpamGroupView) -->
                    <Grid Grid.Column="2">
                        <Border Background="#f8f9fa" BorderBrush="#dadce0" BorderThickness="1" Padding="15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <Grid Grid.Row="0" Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Nút Bắt đầu -->
                                    <Button Grid.Column="0" Command="{Binding StartTaskCommand}" Background="#109c64" Foreground="White" Cursor="Hand" BorderThickness="0" Height="36">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Polygon Points="0,0 10,5 0,10" Fill="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Bắt đầu" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#0d8555"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Background" Value="#a0d8c0"/>
                                                        <Setter Property="Opacity" Value="0.6"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Nút Dừng -->
                                    <Button Grid.Column="2" Command="{Binding StopTaskCommand}" Background="White" BorderBrush="#c82333" Foreground="#c82333" Cursor="Hand" BorderThickness="1" Height="36">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Rectangle Width="8" Height="8" Fill="#c82333" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Dừng" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#fff5f5"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                                
                                <!-- Khung hiển thị log -->
                                <Border Grid.Row="1" BorderBrush="#dadce0" BorderThickness="1" Background="White" CornerRadius="4" Margin="0,0,0,15">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TextBox Text="{Binding LogText}" IsReadOnly="True" BorderThickness="0" Padding="8" Background="Transparent" Foreground="#444" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                    </ScrollViewer>
                                </Border>

                                <!-- Trạng thái chạy -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                                    <!-- Đang chạy icon (spinner) -->
                                    <Grid Width="22" Height="22" Margin="0,0,8,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                        <Ellipse Stroke="#e0e0e0" StrokeThickness="2" Width="18" Height="18"/>
                                        <Path Data="M 11,2 A 9,9 0 0 1 20,11" Stroke="#1a73e8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="0"/>
                                            </Path.RenderTransform>
                                            <Path.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Path.Triggers>
                                        </Path>
                                    </Grid>
                                    
                                    <!-- Đã dừng icon (grey circle with minus) -->
                                    <Border Width="22" Height="22" CornerRadius="11" Background="#f4f5f7" BorderBrush="#e0e0e0" BorderThickness="1.5" Margin="0,0,8,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusText}" Value="Đã dừng">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Rectangle Width="8" Height="1.5" Fill="#666" RadiusX="0.5" RadiusY="0.5"/>
                                    </Border>
                                    
                                    <!-- Đã kết thúc icon (grey circle with dot) -->
                                    <Border Width="22" Height="22" CornerRadius="11" Background="#f4f5f7" BorderBrush="#e0e0e0" BorderThickness="1.5" Margin="0,0,8,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusText}" Value="Đã kết thúc">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Ellipse Width="6" Height="6" Fill="#17509c"/>
                                    </Border>

                                    <!-- Pill text -->
                                    <Border CornerRadius="15" Padding="15,6">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#f4f5f7"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusText}" Value="Đang chạy">
                                                        <Setter Property="Background" Value="#eef2fa"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#666"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusText}" Value="Đang chạy">
                                                            <Setter Property="Foreground" Value="#1a73e8"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusText}" Value="Đã kết thúc">
                                                            <Setter Property="Foreground" Value="#17509c"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
