<Window x:Class="FPlusClone.Views.EditCommentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sửa bình luận" Height="300" Width="400" WindowStartupLocation="CenterOwner" Background="#f0f0f0" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Nhập nội dung bình luận mới:" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>
        <Border Grid.Row="1" BorderBrush="#ccc" BorderThickness="1" Background="White">
            <TextBox x:Name="txtComment" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="8" BorderThickness="0" Background="Transparent"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Hủy" Width="70" Height="28" Margin="0,0,10,0" Background="#fff" BorderBrush="#ccc" BorderThickness="1" Cursor="Hand" Click="Cancel_Click"/>
            <Button Content="Lưu" Width="70" Height="28" Background="#1a73e8" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
